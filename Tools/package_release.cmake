cmake_minimum_required(VERSION 3.21)

if(POLICY CMP0207)
    cmake_policy(SET CMP0207 NEW)
endif()

if(NOT WIN32)
    message(FATAL_ERROR "Release packaging currently supports Windows x64 only.")
endif()

get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT DEFINED BINARY_DIR)
    set(BINARY_DIR "${ROOT}/build/port/bin")
endif()
if(NOT EXISTS "${BINARY_DIR}/sotc.exe")
    message(FATAL_ERROR "sotc.exe is not ready. Let setup.bat finish, then run package-release.bat. Packaging does not start or change the build.")
endif()
if(NOT DEFINED RELEASE_OUTPUT)
    set(RELEASE_OUTPUT "${ROOT}/out/releases")
endif()
get_filename_component(RELEASE_OUTPUT "${RELEASE_OUTPUT}" ABSOLUTE)

find_program(GIT_EXECUTABLE git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}" rev-parse HEAD
    OUTPUT_VARIABLE SOURCE_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}" ls-tree HEAD External/PS2Recomp
    OUTPUT_VARIABLE SUBMODULE_INFO OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT RELEASE_VERSION)
    string(SUBSTRING "${SOURCE_COMMIT}" 0 8 SHORT_COMMIT)
    set(RELEASE_VERSION "experimental-${SHORT_COMMIT}")
endif()
if(NOT RELEASE_VERSION MATCHES "^[A-Za-z0-9][A-Za-z0-9._-]*$")
    message(FATAL_ERROR "Use only letters, digits, dots, underscores, or hyphens in the release version.")
endif()

set(PACKAGE_NAME "sotc-${RELEASE_VERSION}-windows-x64")
set(ARCHIVE "${RELEASE_OUTPUT}/${PACKAGE_NAME}.zip")
if(EXISTS "${ARCHIVE}" OR EXISTS "${ARCHIVE}.partial")
    message(FATAL_ERROR "${ARCHIVE} already exists or has an unfinished package. Choose a new release version or move the previous output.")
endif()

if(NOT CRT_DIRECTORY)
    file(TO_CMAKE_PATH "$ENV{VSROOT}" VS_ROOT)
    file(GLOB CRT_DIRECTORIES LIST_DIRECTORIES TRUE "${VS_ROOT}/VC/Redist/MSVC/*/x64/Microsoft.VC*.CRT")
    list(SORT CRT_DIRECTORIES COMPARE NATURAL ORDER DESCENDING)
    if(CRT_DIRECTORIES)
        list(GET CRT_DIRECTORIES 0 CRT_DIRECTORY)
    endif()
endif()
if(NOT CRT_DIRECTORY OR NOT IS_DIRECTORY "${CRT_DIRECTORY}")
    message(FATAL_ERROR "The MSVC x64 CRT redistributable directory was not found. Run package-release.bat while the build tools are installed.")
endif()
file(GLOB CRT_DLLS "${CRT_DIRECTORY}/*.dll")
if(NOT CRT_DLLS)
    message(FATAL_ERROR "MSVC redistributable DLLs were not found. Run package-release.bat from your build machine, or set CRT_DIRECTORY to its x64 Microsoft.VC*.CRT directory.")
endif()

find_program(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND dumpbin REQUIRED)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL dumpbin)
string(RANDOM LENGTH 10 ALPHABET 0123456789abcdef STAGING_ID)
set(STAGING_PARENT "${RELEASE_OUTPUT}/staging/${STAGING_ID}")
set(STAGING "${STAGING_PARENT}/${PACKAGE_NAME}")
file(MAKE_DIRECTORY "${STAGING}/Game" "${STAGING}/Docs" "${STAGING}/licenses")
file(SHA256 "${BINARY_DIR}/sotc.exe" ORIGINAL_BINARY_SHA256)
file(COPY_FILE "${BINARY_DIR}/sotc.exe" "${STAGING}/sotc.exe")
file(SHA256 "${STAGING}/sotc.exe" BINARY_SHA256)
if(NOT ORIGINAL_BINARY_SHA256 STREQUAL BINARY_SHA256)
    message(FATAL_ERROR "sotc.exe changed while being copied. Wait for setup.bat to finish before packaging.")
endif()
file(COPY ${CRT_DLLS} DESTINATION "${STAGING}")
file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES "${STAGING}/sotc.exe"
    DIRECTORIES "${BINARY_DIR}"
    RESOLVED_DEPENDENCIES_VAR RUNTIME_DLLS
    UNRESOLVED_DEPENDENCIES_VAR MISSING_DLLS
    CONFLICTING_DEPENDENCIES_PREFIX CONFLICTING_DLLS
    PRE_EXCLUDE_REGEXES "^api-ms-" "^ext-ms-"
    POST_EXCLUDE_REGEXES ".*[/\\\\][Ss][Yy][Ss][Tt][Ee][Mm]32[/\\\\].*" ".*[/\\\\][Ss][Yy][Ss][Ww][Oo][Ww]64[/\\\\].*")
if(MISSING_DLLS OR CONFLICTING_DLLS_FILENAMES)
    message(FATAL_ERROR "Cannot package unresolved or conflicting DLLs: ${MISSING_DLLS};${CONFLICTING_DLLS_FILENAMES}")
endif()
foreach(DLL IN LISTS RUNTIME_DLLS)
    get_filename_component(DLL_DIRECTORY "${DLL}" DIRECTORY)
    if(NOT DLL_DIRECTORY STREQUAL STAGING)
        file(COPY "${DLL}" DESTINATION "${STAGING}")
    endif()
endforeach()

file(COPY "${ROOT}/Tools/release/Play.bat" "${ROOT}/Tools/release/README.txt" "${ROOT}/LICENSE" DESTINATION "${STAGING}")
file(COPY "${ROOT}/Tools/release/PLACE-YOUR-ISO-HERE.txt" DESTINATION "${STAGING}/Game")
file(COPY "${ROOT}/Docs/CONFIGURATION.md" DESTINATION "${STAGING}/Docs")
file(COPY_FILE "${ROOT}/External/PS2Recomp/LICENSE" "${STAGING}/licenses/PS2Recomp-LICENSE")
file(COPY_FILE "${ROOT}/build/port/_deps/raylib-src/LICENSE" "${STAGING}/licenses/raylib-LICENSE")
file(COPY_FILE "${ROOT}/build/port/_deps/raylib-src/src/external/glfw/LICENSE.md" "${STAGING}/licenses/GLFW-LICENSE.md")
file(WRITE "${STAGING}/licenses/Microsoft-runtime.txt"
    "Microsoft C++ runtime DLLs are redistributed from the build toolchain's x64 CRT redistributable directory.\nCopyright Microsoft Corporation.\nhttps://learn.microsoft.com/cpp/windows/redistributing-visual-cpp-files\n")
string(TIMESTAMP PACKAGED_AT "%Y-%m-%dT%H:%M:%SZ" UTC)
file(STRINGS "${ROOT}/build/port/CMakeCache.txt" BUILD_TYPE REGEX "^CMAKE_BUILD_TYPE:STRING=")
file(WRITE "${STAGING}/BUILD-INFO.txt"
    "Version: ${RELEASE_VERSION}\nPlatform: Windows x64, AVX2\nBuild configuration: ${BUILD_TYPE}\nPackaged: ${PACKAGED_AT}\nSource commit: ${SOURCE_COMMIT}\nPS2Recomp: ${SUBMODULE_INFO}\nExecutable SHA-256: ${BINARY_SHA256}\nSource: https://github.com/LightVelox/sotc-vibe-pc/tree/${SOURCE_COMMIT}\nDisc: SCES-53326 v1.00 PAL\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "PATH=$ENV{SystemRoot}/System32" "${STAGING}/sotc.exe" --help
    WORKING_DIRECTORY "${STAGING}" RESULT_VARIABLE HELP_RESULT OUTPUT_VARIABLE HELP_OUTPUT ERROR_VARIABLE HELP_ERROR TIMEOUT 30)
file(REMOVE "${STAGING}/sotc.ini")
if(NOT HELP_RESULT EQUAL 0 OR NOT HELP_OUTPUT MATCHES "usage: sotc.*SCES-53326")
    message(FATAL_ERROR "The packaged executable did not pass its standalone startup check: ${HELP_RESULT}\n${HELP_OUTPUT}\n${HELP_ERROR}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${ARCHIVE}.partial" --format=zip -- "${PACKAGE_NAME}"
    WORKING_DIRECTORY "${STAGING_PARENT}" COMMAND_ERROR_IS_FATAL ANY)
file(RENAME "${ARCHIVE}.partial" "${ARCHIVE}")
file(SHA256 "${ARCHIVE}" ARCHIVE_SHA256)
file(WRITE "${ARCHIVE}.sha256" "${ARCHIVE_SHA256}  ${PACKAGE_NAME}.zip\n")
message(STATUS "Release ZIP: ${ARCHIVE}")
message(STATUS "Checksum: ${ARCHIVE}.sha256")
message(STATUS "Verified standalone startup with only Windows and the packaged DLLs on PATH.")
